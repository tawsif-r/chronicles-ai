DATABASE_URL=postgres://chronicles:secret@localhost:5432/chronicles
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 32-char AES key: openssl rand -hex 16
API_KEY_ENCRYPTION_SECRET=

OPENCLAW_PORT_RANGE_START=18800
OPENCLAW_PORT_RANGE_END=19800
# Path to the openclaw runtime: node --import=tsx/esm /absolute/path/to/openclaw/src/main.ts
OPENCLAW_BINARY=node --import=tsx/esm /absolute/path/to/openclaw/src/main.ts

WORKSPACE_BASE_PATH=/workspaces

# Google OAuth2 — Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
